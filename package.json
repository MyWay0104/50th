{
  "name": "slide-master-v2-hyperframes",
  "version": "0.2.0",
  "private": true,
  "description": "Reusable HyperFrames workspace for 16:9 decks and optional card-news outputs.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "hyperframes check",
    "docs": "hyperframes docs",
    "lint": "hyperframes lint",
    "lint:verbose": "hyperframes lint --verbose",
    "localize": "python scripts/deck/localize_assets.py",
    "new-topic": "python scripts/create_topic.py",
    "preview": "hyperframes preview",
    "preview:port": "hyperframes preview --port 3000",
    "qa:rules": "python scripts/deck/qa_rules.py",
    "render": "hyperframes render",
    "skills": "hyperframes skills",
    "snapshot": "hyperframes snapshot",
    "validate:harness": "python scripts/validate_codex_port.py",
    "validate:topic": "python scripts/validate_topic.py"
  },
  "devDependencies": {
    "hyperframes": "0.8.41"
  }
}
